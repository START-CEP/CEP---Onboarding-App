# Copiar a .env.local (app) y supabase/functions/.env (Edge Functions). Nunca subir los valores reales.

# Supabase local: `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bunny Stream (solo servidor / Edge Functions)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=            # Stream → API → API Key de la librería
BUNNY_STREAM_CDN_HOSTNAME=       # vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=     # Stream → Security → Token Authentication Key
BUNNY_STREAM_WEBHOOK_SECRET=     # secreto propio para validar el webhook de codificación
